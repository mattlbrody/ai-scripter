# Database (Supabase)
PG_DSN=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?sslmode=require
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Deepgram (for speech-to-text)
DEEPGRAM_API_KEY=your_deepgram_api_key

# OpenAI (for embeddings)
OPENAI_API_KEY=sk-...

# Backend Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Default Settings
SIM_THRESHOLD_DEFAULT=0.80
TURN_SILENCE_MS=200
MIN_TOKENS=6
STACK_MAX=2
EARLY_SHOW_THRESHOLD=0.88

# Admin UI URL (for CORS)
ADMIN_URL=http://localhost:5173

# Extension ID (for CORS - get this after loading extension in Chrome)
EXTENSION_ID=your_chrome_extension_id